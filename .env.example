# =============================================================================
# Telecom AI Voice Agent — environment template
# Copy to .env and fill in. ⚠ = must be set for a real (live) deployment.
# =============================================================================

# ===================================================================
# 1. DATABASE
# ===================================================================
DATABASE_URL=postgresql+psycopg://telecom:telecom@localhost:5432/telecom
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
POSTGRES_USER=telecom                    # ⚠ CHANGE for prod
POSTGRES_PASSWORD=telecom                # ⚠ CHANGE for prod
POSTGRES_DB=telecom

# ===================================================================
# 2. ADAPTER MODE
# ===================================================================
CONNECTOR_MODE=mock                      # mock | live

# ===================================================================
# 3. SERVICE-TO-SERVICE AUTH
# ===================================================================
INTERNAL_API_KEY=                        # ⚠ set one shared key for staging/prod

# ===================================================================
# 4. EDGE / CORS
# ===================================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ===================================================================
# 5. LIVEKIT (transport)
# ===================================================================
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey                   # ⚠ CHANGE for prod
LIVEKIT_API_SECRET=devsecret_change_me   # ⚠ CHANGE for prod

# ===================================================================
# 6. VOICE + LLM PROVIDERS
# ===================================================================

# --- STT primary ---
DEEPGRAM_API_KEY=                        # ⚠ STT primary (Deepgram)

# --- TTS providers ---
# Choix dynamique du provider principal : cartesia | elevenlabs | inworld | smallestai
TTS_PRIMARY=cartesia

# ElevenLabs (déjà présent : ELEVEN_API_KEY, ELEVEN_VOICE_ID, TTS_MODEL)
ELEVEN_API_KEY=                          # ⚠ TTS primary (ElevenLabs)

# Cartesia (déjà présent : CARTESIA_API_KEY, CARTESIA_TTS_MODEL)
CARTESIA_API_KEY=                        # TTS optional fallback (Cartesia)

# Inworld (fallback, FR GA) — INWORLD_API_KEY est ⚠ Base64 (platform.inworld.ai)
INWORLD_API_KEY=
INWORLD_TTS_MODEL=inworld-tts-2
INWORLD_VOICE_ID=alain

# Smallest.ai (fallback, FR Beta) — modèle STANDARD (pas _pro)
SMALLEST_API_KEY=
SMALLEST_TTS_MODEL=lightning_v3.1
SMALLEST_VOICE_ID=juliette

# Gemini TTS — placeholder UNIQUEMENT (non branché : plugin beta streaming=False)
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# NB : conserver AZURE_SPEECH_KEY (utilisé par le STT, pas par le TTS)
AZURE_SPEECH_KEY=                        # STT final fallback UNIQUEMENT
AZURE_SPEECH_REGION=francecentral

# --- LLM primary ---
GOOGLE_API_KEY=                          # ⚠ LLM primary (Gemini 2.5 Flash)

# --- LLM fallbacks (add keys to activate each tier) ---
OPENAI_API_KEY=                          # LLM fallback tier-1 (GPT-4o-mini)
NVIDIA_API_KEY=                          # LLM fallback tier-2 (NVIDIA NIM)
GROQ_API_KEY=                            # LLM fallback tier-3 (Groq)

# --- STT optional extra fallback ---
GLADIA_API_KEY=                          # STT optional fallback (Gladia)

# ===================================================================
# 7. MODEL SELECTION
# ===================================================================
STT_MODEL=nova-3
TTS_MODEL=eleven_flash_v2_5
ELEVEN_VOICE_ID=EXAVITQu4vr4xnSDxMaL
DEEPGRAM_TTS_MODEL=aura-asteria-en
DEEPGRAM_TTS_VOICE=aura-asteria-en

# LLM chain: Gemini 2.5 Flash primary → NVIDIA NIM → OpenAI GPT-4o-mini → Groq
LLM_PRIMARY_MODEL=gemini-2.5-flash
LLM_FALLBACK_MODEL=gpt-4o-mini

# NVIDIA NIM (optional fallback — tier 2)
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_TIMEOUT_S=45.0

# Groq (optional fallback — tier 3)
GROQ_MODEL=llama3-8b-8192
GROQ_TIMEOUT_S=30.0

# Cartesia TTS model
CARTESIA_TTS_MODEL=sonic-3

# --- Voix par agent (persona) — primary Cartesia ------------------------------
# UUID de voix Cartesia par persona. Laisse VIDE pour utiliser la voix de base.
# Colle des UUID RÉELS depuis ta bibliothèque Cartesia (play.cartesia.ai / doc
# LiveKit×Cartesia). NE PAS inventer d'UUID. Sonic = multilingue (fr/ar/en).
CARTESIA_VOICE_TRIAGE=
CARTESIA_VOICE_TECHNICAL=
CARTESIA_VOICE_BILLING=
CARTESIA_VOICE_ACCOUNT=
CARTESIA_VOICE_MANAGER=

# ===================================================================
# 8. VAD / TURN / LATENCY
# ===================================================================
VAD_MIN_SILENCE=0.25
PREEMPTIVE_GENERATION=True
# Collecte du consentement d'enregistrement au debut de l'appel.
# false = saute la question (economise ~24% du TTS par appel, developpement seulement).
RECORDING_CONSENT_ENABLED=true
NOISE_CANCELLATION=False
DECISION_CONFIDENCE_THRESHOLD=0.5

# ===================================================================
# 9. CHAOS / RESILIENCE (set True to break a primary)
# ===================================================================
CHAOS_BREAK_STT=False
CHAOS_BREAK_LLM=False
CHAOS_BREAK_TTS=False

# ===================================================================
# 10. LANGUAGE / SESSION
# ===================================================================
SUPPORTED_LANGUAGES=fr,ar,en
DEFAULT_LANGUAGE=fr
SESSION_LANGUAGE=fr
SESSION_CALLER_MSISDN=

# ===================================================================
# 11. DOMAIN SERVICE URLs
# ===================================================================
CONTEXT_SERVICE_URL=http://localhost:8101
KNOWLEDGE_SERVICE_URL=http://localhost:8102
DECISION_SERVICE_URL=http://localhost:8103
POLICY_SERVICE_URL=http://localhost:8104
EXECUTION_SERVICE_URL=http://localhost:8105
NOTIFICATION_SERVICE_URL=http://localhost:8106

# ===================================================================
# 12. MCP SERVER URLs
# ===================================================================
KNOWLEDGE_MCP_URL=http://localhost:8201/mcp
TICKETING_MCP_URL=http://localhost:8202/mcp
MESSAGING_MCP_URL=http://localhost:8203/mcp

# ===================================================================
# 13. MCP HOST/PORT
# ===================================================================
MCP_HOST=0.0.0.0

# ===================================================================
# 14. GLPI TICKETING (live). Unset = mock
# ===================================================================
# Ticketing is LIVE-ONLY: these three are REQUIRED for the ticketing-glpi service to start
# (independent of CONNECTOR_MODE). There is no mock ticketing backend.
#GLPI_BASE_URL=https://voiceagentai.fr33.glpi-network.cloud/api.php/v1 #old api glpi endpoint
GLPI_BASE_URL=                           # ⚠ e.g. http://glpi:80/apirest.php (local) or https://glpi.telecom.tn/apirest.php
GLPI_APP_TOKEN=                          # ⚠
GLPI_USER_TOKEN=                         # ⚠
# Local GLPI stack only (infra/docker-compose/docker-compose.glpi.yml):
GLPI_DB_ROOT_PASSWORD=glpiroot
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=glpi
GLPI_TIMEZONE=Europe/Paris

# ===================================================================
# 15. NOTIFICATION (live-only) — Twilio SMS / WhatsApp + SMTP email.
#     No mock fallback. Unconfigured = honest failure.
#     WhatsApp is the PRIMARY messaging channel (SMS is unavailable in some countries, e.g. TN).
#     WhatsApp and email are independent; configure either or both. SMS stays supported in code.
# ===================================================================
TWILIO_ACCOUNT_SID=                      # ⚠ SMS/WhatsApp (Twilio)
TWILIO_AUTH_TOKEN=                       # ⚠
TWILIO_SMS_FROM=                         # e.g. +21620155320
TWILIO_WHATSAPP_FROM=+14155238886        # WhatsApp sender (Twilio sandbox default). PRIMARY channel.
SENDGRID_API_KEY=                        # ⚠ email fallback
EMAIL_FROM=                              # e.g. noreply@telecom.tn
SMTP_HOST=                               # e.g. smtp.telecom.tn
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ===================================================================
# 16. LEGACY SYSTEM ADAPTER URLs (live). Unset = mock
# ===================================================================
# OCS + Billing point at the local simulator (a REAL Postgres-backed ledger) by default. In
# production, swap these for the carrier's OCS/billing REST endpoints - no code change.
# Only read when CONNECTOR_MODE=live.
OCS_ADAPTER_URL=http://ocs-billing-sim:8107
BILLING_ADAPTER_URL=http://ocs-billing-sim:8107
PAYMENT_ADAPTER_URL=                     # ⚠ e.g. https://payment.telecom.tn/api
CRM_ADAPTER_URL=                         # ⚠ e.g. https://crm.telecom.tn/api
# Network supervision (known outages). Points at the local NMS simulator, which projects the
# real oss.outages table. Swap for the carrier NMS/OSS in production - no code change.
NMS_ADAPTER_URL=http://nms-sim:8108
# The agent's technical persona reads incidents through this service directly.
NMS_SERVICE_URL=http://nms-sim:8108
# Geo resolver thresholds (Patch v59).
# GEO_MATCH_THRESHOLD: pg_trgm similarity cutoff for fuzzy zone matching (0.0-1.0).
#   Lower = more tolerant to typos, higher = stricter. 0.45 is tested and recommended.
GEO_MATCH_THRESHOLD=0.45
# GEO_SUGGESTION_LIMIT: max number of zone suggestions offered when area is unrecognised.
#   Keep at 3 for voice (more is inaudible).
# BUSINESS_API_URL=http://localhost:8107
BUSINESS_API_URL=http://localhost:8107
# STT_KEYTERM_SCOPE: governorate codes to scope keyterms passed to Deepgram STT
STT_KEYTERM_SCOPE=TN-71,TN-51,TN-52
# Points at the local provisioning simulator (in-memory SIM ledger). Swap for the carrier
# provisioning/HLR system in production - no code change.
PROVISIONING_ADAPTER_URL=http://provisioning-sim:8109
GLPI_ADAPTER_URL=                        # ⚠ e.g. https://glpi.telecom.tn/apirest.php

# ===================================================================
# 17. KNOWLEDGE / RAG (Qdrant) — Phase 8 hybrid (dense + BM25 + RRF)
# ===================================================================
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=telecom_knowledge
QDRANT_TIMEOUT_S=10
# Local, quantized, CPU-only ONNX embeddings: no API key, no quota, no rate limit, no GPU.
# 384 dims matches knowledge.chunks + the Qdrant collection; ar/fr/en share one aligned vector
# space, so a French question retrieves an English procedure without translation.
# Baked into the knowledge-service image at build time. Changing the model or the dimension
# invalidates every stored vector: recreate the collection AND re-ingest.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSIONS=384
EMBEDDING_CACHE_DIR=/opt/models

# --- Relevance gate (dense cosine FLOOR) ----------------------------------------------------
# The corpus is now 100% French, so same-language E5-small similarity is high and well-separated
# (unlike the cross-lingual Phase 6-7 corpus where noise and signal inverted). A dense cosine
# FLOOR is the relevance gate again: passages below it are noise. BM25 + RRF only reorder what
# already cleared this gate — keyword precision, not a second gate.
# Calibrated with scripts/knowledge_score_probe.py. These are STARTING values; re-run the probe.
KNOWLEDGE_SCORE_FLOOR=0.82
KNOWLEDGE_RELATIVE_CUTOFF=0.90

# --- Hybrid dense + BM25 + RRF (Phase 8) ----------------------------------------------------
# Dense E5 search is the relevance GATE: score_threshold = FLOOR. BM25 sparse search with RRF
# fusion reorders the dense survivors for keyword precision. Both searches run in the named-
# vector collection (dense=384d cosine, bm25=sparse IDF).
# If HYBRID is off, retrieval is dense-only (score_threshold still applies).
KNOWLEDGE_HYBRID_ENABLED=true
# RRF constant — 1/(k + rank). Lower = more weight on top ranks. 60 is the literature default.
KNOWLEDGE_RRF_K=60
# Default language filter. The corpus is French-only; cross-lingual queries cannot leak in.
KNOWLEDGE_DEFAULT_LANGUAGE=fr
# Sparse BM25 model. Tiny, bundled with fastembed.
KNOWLEDGE_SPARSE_MODEL=Qdrant/bm25
# LRU query cache for E5 dense embeddings (repeated FAQ questions on a voice line skip re-embed).
KNOWLEDGE_QUERY_CACHE=256

# --- Lexical (BM25) co-gate (Phase 8.1) -----------------------------------------------------
# A query must have real keyword support in the corpus, not just a same-language cosine glow.
# max BM25 score among sparse hits must clear this. 0 = disabled.
# CALIBRATE from scripts/knowledge_score_probe.py (Step 1) before raising above 0.
KNOWLEDGE_SPARSE_MIN=0.0

# --- Small multilingual cross-encoder gate (Phase 8.1) -------------------------------------
# Runs ONLY on the survivors of the dense+lexical gates. ~118 MB, ONNX-quantized, ~80-150 ms.
# Lives OUTSIDE the readiness gate: on failure it degrades to the dense+lexical result (no 503).
KNOWLEDGE_CE_GATE_ENABLED=true
KNOWLEDGE_CE_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
KNOWLEDGE_CE_THRESHOLD=0.30
KNOWLEDGE_CE_MAX_CANDIDATES=8

# --- Over-fetch count for hybrid ------------------------------------------------------------
# Both the dense and sparse stages fetch this many candidates before RRF fusion. Higher = better
# recall at the cost of more Qdrant I/O. 12 is a reasonable balance for a ~300-chunk corpus.
KNOWLEDGE_RERANK_CANDIDATES=12

# --- Cross-encoder reranker (Phase 7, RETIRED from realtime path) ---------------------------
# Kept for offline A/B evaluation. NOT on the realtime path: hybrid dense+BM25+RRF is the gate.
# Enable only for eval runs — 1.1 GB RAM, 2-5s per query.
KNOWLEDGE_RERANKER_ENABLED=false
KNOWLEDGE_RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
# Over-fetch count is shared with the hybrid path (KNOWLEDGE_RERANK_CANDIDATES above).
KNOWLEDGE_RERANK_THRESHOLD=0.5
KNOWLEDGE_RERANKER_THREADS=0

# Outage guard for the agent's knowledge_search tool (retrieval is ~50ms warm).
KNOWLEDGE_SEARCH_TIMEOUT_S=5.0
MINIO_SECURE=false

# ===================================================================
# 18. CACHE (Redis)
# ===================================================================
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# ===================================================================
# 19. OBJECT STORAGE (MinIO)
# ===================================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin               # ⚠ CHANGE for prod
MINIO_ROOT_PASSWORD=minioadmin           # ⚠ CHANGE for prod
MINIO_BUCKET=call-recordings
# Knowledge corpus lives in its OWN bucket: call recordings are PII with a retention
# policy, knowledge documents are versioned reference content. Never mix the two.
KNOWLEDGE_MINIO_BUCKET=telecom-knowledge
# Chunking budget in CHARACTERS, not tokens: Arabic packs far fewer characters per
# token than French, and e5 truncates at 512 tokens.
KNOWLEDGE_CHUNK_MAX_CHARS=1200
KNOWLEDGE_CHUNK_OVERLAP_CHARS=150
KNOWLEDGE_EMBED_BATCH=32
# Upload guard for POST /knowledge/upload (PDF/DOCX/CSV/JSON/MD/TXT).
KNOWLEDGE_MAX_UPLOAD_MB=25

# ===================================================================
# 20. OBSERVABILITY
# ===================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=telecom-agent

# ===================================================================
# 21. POLICY SERVICE THRESHOLDS
# ===================================================================
POLICY_PAYMENT_CAP_TND=200.0
POLICY_DEFERRAL_MIN_AGE_DAYS=180
POLICY_DEFERRAL_MAX_PER_YEAR=2
POLICY_DEFERRAL_UNPAID_THRESHOLD_TND=150.0

# ===================================================================
# 22. BUSINESS API RBAC
# ===================================================================
BUSINESS_API_DEFAULT_ROLE=administrateur

# ===================================================================
# 23. BACKUP
# ===================================================================
BACKUP_DIR=./backups

# ===================================================================
# 24. LOGGING
# ===================================================================
LOG_LEVEL=INFO

# ===================================================================
# 25. FRONTENDS (Vite)
# ===================================================================
VITE_TOKEN_URL=http://localhost:8107
VITE_BUSINESS_API_URL=http://localhost:8108
VITE_API_ROLE=administrateur
