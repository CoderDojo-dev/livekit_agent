# =============================================================================
# Telecom AI Voice Agent — environment template
# Copy to .env and fill in. ⚠ = must be set for a real (live) deployment.
# =============================================================================

# ===================================================================
# 1. DATABASE
# ===================================================================
DATABASE_URL=postgresql+psycopg://telecom:telecom@localhost:5432/telecom
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
POSTGRES_USER=telecom                    # ⚠ CHANGE for prod
POSTGRES_PASSWORD=telecom                # ⚠ CHANGE for prod
POSTGRES_DB=telecom

# ===================================================================
# 2. ADAPTER MODE
# ===================================================================
CONNECTOR_MODE=mock                      # mock | live

# ===================================================================
# 3. SERVICE-TO-SERVICE AUTH
# ===================================================================
INTERNAL_API_KEY=                        # ⚠ set one shared key for staging/prod

# ===================================================================
# 4. EDGE / CORS
# ===================================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ===================================================================
# 5. LIVEKIT (transport)
# ===================================================================
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey                   # ⚠ CHANGE for prod
LIVEKIT_API_SECRET=devsecret_change_me   # ⚠ CHANGE for prod

# ===================================================================
# 6. VOICE + LLM PROVIDERS
# ===================================================================

# --- STT primary ---
DEEPGRAM_API_KEY=                        # ⚠ STT primary (Deepgram)

# --- TTS providers ---
ELEVEN_API_KEY=                          # ⚠ TTS primary (ElevenLabs)
CARTESIA_API_KEY=                        # TTS optional fallback (Cartesia)
AZURE_SPEECH_KEY=                        # STT/TTS final fallback
AZURE_SPEECH_REGION=francecentral

# --- LLM primary ---
GOOGLE_API_KEY=                          # ⚠ LLM primary (Gemini 2.5 Flash)

# --- LLM fallbacks (add keys to activate each tier) ---
OPENAI_API_KEY=                          # LLM fallback tier-1 (GPT-4o-mini)
NVIDIA_API_KEY=                          # LLM fallback tier-2 (NVIDIA NIM)
GROQ_API_KEY=                            # LLM fallback tier-3 (Groq)

# --- STT optional extra fallback ---
GLADIA_API_KEY=                          # STT optional fallback (Gladia)

# ===================================================================
# 7. MODEL SELECTION
# ===================================================================
STT_MODEL=nova-3
TTS_MODEL=eleven_flash_v2_5
ELEVEN_VOICE_ID=EXAVITQu4vr4xnSDxMaL
DEEPGRAM_TTS_MODEL=aura-asteria-en
DEEPGRAM_TTS_VOICE=aura-asteria-en

# LLM chain: Gemini 2.5 Flash primary → NVIDIA NIM → OpenAI GPT-4o-mini → Groq
LLM_PRIMARY_MODEL=gemini-2.5-flash-latest
LLM_FALLBACK_MODEL=gpt-4o-mini

# NVIDIA NIM (optional fallback — tier 2)
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_TIMEOUT_S=45.0

# Groq (optional fallback — tier 3)
GROQ_MODEL=llama3-8b-8192
GROQ_TIMEOUT_S=30.0

# Cartesia TTS model
CARTESIA_TTS_MODEL=sonic-2

# ===================================================================
# 8. VAD / TURN / LATENCY
# ===================================================================
VAD_MIN_SILENCE=0.25
PREEMPTIVE_GENERATION=True
NOISE_CANCELLATION=False
DECISION_CONFIDENCE_THRESHOLD=0.5

# ===================================================================
# 9. CHAOS / RESILIENCE (set True to break a primary)
# ===================================================================
CHAOS_BREAK_STT=False
CHAOS_BREAK_LLM=False
CHAOS_BREAK_TTS=False

# ===================================================================
# 10. LANGUAGE / SESSION
# ===================================================================
SUPPORTED_LANGUAGES=fr,ar,en
DEFAULT_LANGUAGE=fr
SESSION_LANGUAGE=fr
SESSION_CALLER_MSISDN=

# ===================================================================
# 11. DOMAIN SERVICE URLs
# ===================================================================
CONTEXT_SERVICE_URL=http://localhost:8101
KNOWLEDGE_SERVICE_URL=http://localhost:8102
DECISION_SERVICE_URL=http://localhost:8103
POLICY_SERVICE_URL=http://localhost:8104
EXECUTION_SERVICE_URL=http://localhost:8105
NOTIFICATION_SERVICE_URL=http://localhost:8106

# ===================================================================
# 12. MCP SERVER URLs
# ===================================================================
KNOWLEDGE_MCP_URL=http://localhost:8201/mcp
TICKETING_MCP_URL=http://localhost:8202/mcp
MESSAGING_MCP_URL=http://localhost:8203/mcp

# ===================================================================
# 13. MCP HOST/PORT
# ===================================================================
MCP_HOST=0.0.0.0

# ===================================================================
# 14. GLPI TICKETING (live). Unset = mock
# ===================================================================
GLPI_BASE_URL=                           # ⚠ e.g. https://glpi.telecom.tn/apirest.php
GLPI_APP_TOKEN=                          # ⚠
GLPI_USER_TOKEN=                         # ⚠

# ===================================================================
# 15. MESSAGING / NOTIFICATION (live). Unset = mock
# ===================================================================
TWILIO_ACCOUNT_SID=                      # ⚠ SMS/WhatsApp
TWILIO_AUTH_TOKEN=                       # ⚠
TWILIO_SMS_FROM=                         # e.g. +21620155320
TWILIO_WHATSAPP_FROM=                    # e.g. +14155238886
SENDGRID_API_KEY=                        # ⚠ email fallback
EMAIL_FROM=                              # e.g. noreply@telecom.tn
SMTP_HOST=                               # e.g. smtp.telecom.tn
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ===================================================================
# 16. LEGACY SYSTEM ADAPTER URLs (live). Unset = mock
# ===================================================================
OCS_ADAPTER_URL=                         # ⚠ e.g. https://ocs.telecom.tn/api
BILLING_ADAPTER_URL=                     # ⚠ e.g. https://billing.telecom.tn/api
PAYMENT_ADAPTER_URL=                     # ⚠ e.g. https://payment.telecom.tn/api
CRM_ADAPTER_URL=                         # ⚠ e.g. https://crm.telecom.tn/api
NMS_ADAPTER_URL=                         # ⚠ e.g. https://nms.telecom.tn/api
PROVISIONING_ADAPTER_URL=                # ⚠ e.g. https://provisioning.telecom.tn/api
GLPI_ADAPTER_URL=                        # ⚠ e.g. https://glpi.telecom.tn/apirest.php

# ===================================================================
# 17. KNOWLEDGE / RAG (Qdrant)
# ===================================================================
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=telecom_knowledge
EMBEDDING_MODEL=text-embedding-3-small

# ===================================================================
# 18. CACHE (Redis)
# ===================================================================
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# ===================================================================
# 19. OBJECT STORAGE (MinIO)
# ===================================================================
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin               # ⚠ CHANGE for prod
MINIO_ROOT_PASSWORD=minioadmin           # ⚠ CHANGE for prod
MINIO_BUCKET=call-recordings
MINIO_SECURE=false

# ===================================================================
# 20. OBSERVABILITY
# ===================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=telecom-agent

# ===================================================================
# 21. POLICY SERVICE THRESHOLDS
# ===================================================================
POLICY_PAYMENT_CAP_TND=200.0
POLICY_DEFERRAL_MIN_AGE_DAYS=180
POLICY_DEFERRAL_MAX_PER_YEAR=2
POLICY_DEFERRAL_UNPAID_THRESHOLD_TND=150.0

# ===================================================================
# 22. BUSINESS API RBAC
# ===================================================================
BUSINESS_API_DEFAULT_ROLE=administrateur

# ===================================================================
# 23. BACKUP
# ===================================================================
BACKUP_DIR=./backups

# ===================================================================
# 24. LOGGING
# ===================================================================
LOG_LEVEL=INFO

# ===================================================================
# 25. FRONTENDS (Vite)
# ===================================================================
VITE_TOKEN_URL=http://localhost:8107
VITE_BUSINESS_API_URL=http://localhost:8108
VITE_API_ROLE=administrateur
